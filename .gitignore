# ============================================
# Biniyam Beauty Academy — Root .gitignore
# ============================================

# ── Dependencies ──
node_modules/
**/node_modules/
vendor/

# ── Environment / Secrets ──
.env
.env.*
!.env.example

# ── Build output ──
dist/
dist-ssr/

# ── Logs ──
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ── IDE / Editor ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ──
.DS_Store
Thumbs.db
Desktop.ini

# ── TypeScript ──
*.tsbuildinfo

# ── PHP uploads ──
Biniyam_PHP/uploads/
Biniyam_PHP/docs/